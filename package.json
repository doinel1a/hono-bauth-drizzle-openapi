{
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Doinel Atanasiu",
    "email": "doinel+github@atanasiu.me",
    "url": "https://links.atanasiu.me"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/doinel1a/hono-bauth-drizzle-openapi"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "prepare": "husky",
    "dev": "tsx src/env.ts && tsx watch src/index.ts",
    "build": "tsup",
    "start": "tsx src/env.ts && node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write **/**/*.{js,mjs,cjs,ts,mts,cts} --cache",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "ba:auth": "npx auth@latest generate",
    "db:studio": "drizzle-kit --config=drizzle/config.ts studio",
    "db:push": "drizzle-kit --config=drizzle/config.ts push",
    "db:create-migration": "drizzle-kit --config=drizzle/config.ts generate",
    "db:migrate": "drizzle-kit --config=drizzle/config.ts migrate"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.3",
    "@loglayer/hono": "2.4.0",
    "@loglayer/transport-simple-pretty-terminal": "3.3.0",
    "@scalar/hono-api-reference": "0.12.6",
    "@t3-oss/env-core": "0.13.11",
    "better-auth": "1.7.6",
    "dotenv": "18.0.4",
    "drizzle-orm": "0.45.3",
    "drizzle-zod": "0.8.3",
    "hono": "4.13.10",
    "loglayer": "9.4.0",
    "pg": "8.23.0",
    "serialize-error": "13.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@electric-sql/pglite": "0.5.8",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-drizzle": "0.2.3",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-sonarjs": "4.2.2",
    "eslint-plugin-unicorn": "76.0.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  }
}
